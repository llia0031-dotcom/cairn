{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A desk that answers from an organisation's own published rules and quotes them word for word. This instance holds Monash University's public pages for students, in English or Chinese.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "ingest": "node scripts/ingest.js",
    "eval:retrieval": "node scripts/eval-retrieval.js",
    "test": "node --test",
    "ingest:monash": "node scripts/ingest-monash.js",
    "eval:local": "node scripts/eval-local.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@huggingface/transformers": "4.3.2",
    "@langchain/textsplitters": "1.0.2",
    "@orama/orama": "3.1.18",
    "@orama/plugin-data-persistence": "3.1.18",
    "cheerio": "1.2.0",
    "express": "5.3.0"
  }
}
